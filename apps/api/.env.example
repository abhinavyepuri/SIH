# =============================================================================
# SIH_basic — Backend API Environment Template
# =============================================================================
# This is a SAFE template to commit to Git — it has NO real secrets.
# To get started: copy this file to .env and fill in your actual values.
#   cp .env.example .env
# =============================================================================

# Application
APP_ENV=development

# ---------------------------------------------------------------------------
# PostgreSQL Database Credentials
# ---------------------------------------------------------------------------
POSTGRES_USER=your_db_username
POSTGRES_PASSWORD=your_db_password
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=your_database_name

# ---------------------------------------------------------------------------
# Admin Super User Credentials
# The hardcoded admin bypass uses these values — change them in production!
# ---------------------------------------------------------------------------
ADMIN_EMAIL=admin@yourdomain.com
ADMIN_PASSWORD=change_this_strong_password

# ---------------------------------------------------------------------------
# Stripe Payment Gateway
# Get keys from: https://dashboard.stripe.com/test/apikeys
# Use sk_test_ / pk_test_ for development, sk_live_ / pk_live_ for production.
# ---------------------------------------------------------------------------
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PUBLISHABLE_KEY=pk_test_...

# ---------------------------------------------------------------------------
# JWT Token Signing Secret
# Generate a strong random value: openssl rand -hex 64
# ---------------------------------------------------------------------------
JWT_SECRET=replace_with_long_random_secret_string
JWT_ALGORITHM=HS256

# ---------------------------------------------------------------------------
# Redis Cache
# ---------------------------------------------------------------------------
REDIS_URL=redis://localhost:6379

# ---------------------------------------------------------------------------
# Cloudinary Storage Credentials
# Sign up at: https://cloudinary.com/
# Get keys from: https://console.cloudinary.com/
# ---------------------------------------------------------------------------
CLOUDINARY_CLOUD_NAME=your_cloud_name_here
CLOUDINARY_API_KEY=your_api_key_here
CLOUDINARY_API_SECRET=your_api_secret_here
